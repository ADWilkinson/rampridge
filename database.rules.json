{
  "rules": {
    ".read": false,
    ".write": false,
    "worlds": {
      "$world": {
        ".read": "$world.matches(/^3[0-9][0-9]$/)",
        "chat": {
          ".indexOn": ["t"]
        },
        "events": {
          ".indexOn": ["t"]
        },
        "players": {
          ".indexOn": ["ls"]
        }
      }
    }
  }
}
