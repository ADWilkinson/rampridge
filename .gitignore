# Bake inputs: the OSRS cache (archive.openrs2.org) and RuneStar's fonts, downloaded by scripts/bake
.cache/
scripts/bake/node_modules/

# Game assets decoded from the Old School RuneScape cache are Jagex's and stay out of git.
# `bun run setup:assets` rebuilds them, scripts/og captures the link previews, and
# scripts/deploy.sh copies them into the deploy after checking scripts/bake/assets.lock.json.
# The RampRidge wordmark (Cinzel) is ours and stays tracked.
/public/game/*
!/public/game/ui/
/public/game/ui/*
!/public/game/ui/logo.png
!/public/game/ui/privy-logo.png
/public/og.png
/public/og-square.png
/public/og-bg.png
/public/og-coins.png
