{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile",
  "outputDirectory": "dist",
  "functions": {
    "api/og.ts": {
      "includeFiles": "public/{og.png,og-bg.png,og-coins.png,game/ui/logo.png,game/fonts/RuneScape-Bold-12.ttf,game/fonts/RuneScape-Plain-12.ttf}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rampridge.xyz"
        }
      ],
      "destination": "https://www.rampridge.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rampridge.xyz"
        }
      ],
      "destination": "https://www.rampridge.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/t/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/favicon.ico",
      "destination": "/game/ui/favicon.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/game/ui/apple-touch-icon.png"
    },
    {
      "source": "/((?!api/|assets/|game/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game/((?!actors/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/game/actors/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og|og-square|og-bg|og-coins).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/prune",
      "schedule": "* * * * *"
    }
  ]
}
