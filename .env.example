# RampRidge environment variables.
#
# Local development: copy this file to .env.local (gitignored) and adjust:
#   cp .env.example .env.local
# The values below are placeholders. Never commit real secrets. Production keeps
# its values in the Vercel project's environment variables.

# -----------------------------------------------------------------------------
# Server: the Vercel functions in api/, and the local dev API (scripts/dev-api.ts)
# -----------------------------------------------------------------------------

# Point the API at the Realtime Database emulator (bash scripts/load/emulator.sh
# listens on 127.0.0.1:9460). The local API answers 503 until this or
# RAMPRIDGE_DEV_LIVE_DB=1 is set, and while it is set FIREBASE_SERVICE_ACCOUNT
# is never loaded. The dev server's page reads the same emulator.
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9460

# Maintainer only: let the local API write to the live database (rampridge-world).
# Needs FIREBASE_SERVICE_ACCOUNT. Contributors leave it unset.
# RAMPRIDGE_DEV_LIVE_DB=1

# Firebase Admin SDK service account JSON on one line. Production only: the
# emulator needs no credentials.
FIREBASE_SERVICE_ACCOUNT=

# HMAC key for player session tokens, at least 32 bytes. Generate a real one with
# `openssl rand -base64 48`; this placeholder is only fit for the emulator.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789

# Base mainnet JSON-RPC the server reads to verify announced trades and stalls.
# The public endpoint works for development; production uses a keyed provider.
BASE_RPC_URL=https://mainnet.base.org

# Bearer secret Vercel Cron sends to /api/cron/prune.
CRON_SECRET=local-dev-cron-secret-change-me

# Optional switches.
# RAMPRIDGE_TELEMETRY=off       # /api/log accepts and drops everything (a redeploy applies it)
# SESSION_NOT_BEFORE=           # unix seconds: refuse session tokens issued before it

# -----------------------------------------------------------------------------
# Browser: VITE_* values are baked into the bundle at build time, so they are
# public. Everything else the page needs is fixed in src/config.ts.
# -----------------------------------------------------------------------------

# Base JSON-RPC for the browser's reads, if the public endpoint rate-limits you.
# VITE_BASE_RPC_URL=https://mainnet.base.org

# Telemetry: on only for production builds served from www.rampridge.xyz.
# 1 forces it on, 0 forces it off.
# VITE_TELEMETRY=0

# -----------------------------------------------------------------------------
# Test suites outside `bun run check` (shell env; see README "Testing")
# -----------------------------------------------------------------------------

# Archive-capable Base mainnet RPC that the fork, send-fork, parity and e2e
# suites fork from (for example an Alchemy Base URL). It carries an API key:
# the suites never print it.
# FORK_UPSTREAM_RPC_URL=
