{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "fetch-cache.ts",
    "fetch-fonts.ts",
    "setup.ts",
    "optimize-png.ts",
    "lib/**/*.ts",
    "steps/**/*.ts",
    "preview/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}
